{
  "license": "MIT",
  "tasks": {
    "build": "deno run -A --min-dep-age=0 scripts/build.ts",
    "start": "deno run -A --min-dep-age=0 server.ts",
    "dev": "deno task build && deno task start",
    "check": "deno check --min-dep-age=0 src/main.ts src/controls.ts src/sample.ts src/limits.ts server.ts scripts/build.ts",
    "lint": "deno lint",
    "test": "deno test -A --min-dep-age=0 tests/",
    "ci": "deno task check && deno task lint && deno task test && deno task build"
  },
  "deploy": {
    "build": "deno task build",
    "runtime": {
      "type": "static",
      "cwd": "./dist",
      "spa": true
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/http": "jsr:@std/http@^1.0.21",
    "@std/path": "jsr:@std/path@^1.1.2",
    "image-to-pixel-art": "jsr:@sherotree/image-to-pixel-art@0.1.0",
    "image-to-pixel-art/browser": "jsr:@sherotree/image-to-pixel-art@0.1.0/browser"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"],
    "strict": true
  },
  "lint": {
    "exclude": ["dist/"]
  },
  "fmt": {
    "exclude": ["dist/"]
  }
}
